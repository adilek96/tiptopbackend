# Значения задаются в Coolify (Application -> Environment Variables),
# в репозиторий попадает только этот список без секретов.

# Подключения
DATABASE_URL=postgres://пользователь:пароль@хост:5432/база
REDIS_URL=redis://default:пароль@хост:6379/0

# Секреты сессий и токенов
JWT_SECRET=
COOKIE_SECRET=

# Домены, которым разрешено обращаться к API
STORE_CORS=https://tiptop.169-58-147-171.sslip.io
ADMIN_CORS=https://api.tiptop.169-58-147-171.sslip.io
AUTH_CORS=https://tiptop.169-58-147-171.sslip.io,https://api.tiptop.169-58-147-171.sslip.io

# S3-совместимое хранилище картинок (MinIO)
S3_FILE_URL=https://s3.tiptop.169-58-147-171.sslip.io/tiptop
S3_ENDPOINT=https://s3.tiptop.169-58-147-171.sslip.io
S3_BUCKET=tiptop
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Уведомления о заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Идентификаторы способов доставки — печатает src/scripts/seed.ts.
# Нужны, чтобы уведомление в Telegram знало, какие поля показывать.
SHIPPING_OPTION_METRO_ID=
SHIPPING_OPTION_CITY_ID=
SHIPPING_OPTION_COUNTRY_ID=

# Поиск по каталогу (Meilisearch). Без этих переменных модуль молча
# выключается: подписчики ничего не делают, /store/search отдаёт пусто.
MEILISEARCH_HOST=http://tiptop-meilisearch:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=products

# Импорт товара по тексту с Taobao / Amazon / Alibaba.
# Без ключа импорт всё равно работает: фото переносятся, а описание берётся
# из вставленного текста как есть, без генерации и перевода.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
